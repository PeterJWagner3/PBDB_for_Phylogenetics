begin mrbayes;

set autoclose=yes nowarn=yes;

lset coding=variable rates=gamma;

ctype ordered: 4 6 17 38 75 80 86 202 203 233;

Outgroup Clypeus;

constraint ingroup=2-.;

prset topologypr=constraints(ingroup);


calibrate
Clypeus=uniform(155.7,174.7)
Collyrites=uniform(129.4,167.7)
Acrolusia=uniform(100.5,145.95)
Disaster=uniform(136.4,164.7)
Tithonia=uniform(100.5,164.7)
Desorella=uniform(160.09,170.3)
Hyboclypus=uniform(160.09,168.69)
Toxaster=uniform(99.6,145)
Pseudholaster=uniform(89.3,122.4)
Hemipneustes=uniform(61.6,83.6)
Holaster_laevis=uniform(100.5,113)
Holaster_nodulosus=uniform(93.5,99.6)
Eoholaster_laffittei=uniform(139.8,145)
Neoholaster_albensis=uniform(7.2,15.98)
Echinocorys=uniform(66,145)
Galeola_papillosa=uniform(72.1,83.6)
Cardiaster=uniform(66,145)
Cardiotaxis=uniform(66,99.6)
Stegaster=uniform(61.6,83.6)
Stenonaster=uniform(66,93.9)
Toxopatagus=uniform(13.8,20.4)
Giraliaster=uniform(21.7,86.3)
Somaliaster=uniform(66,83.6)
Periaster=uniform(61.6,99.6)
Plesiaster=uniform(70.6,145)
Micraster=uniform(66,99.6)
Coraster=uniform(56,83.5)
Antillaster=uniform(11.6,23.03)
Unifascia=uniform(33.9,47.8)
Macropneustes=uniform(28.1,41.2)
Corystus=uniform(0,40)
Calymne=fixed(0)
Palaeostoma=fixed(0)
Hemiaster=uniform(99.6,122.4)
Ovulaster=uniform(61.45,65.95)
Maretia=uniform(0,5.41.3)
Spatangus=uniform(0,5.41.3)
Eurypatagus=fixed(0)
Eupatagus=fixed(0)
Plexechinus=fixed(0)
Urechinus=fixed(0)
Pourtalesia=fixed(0)
Carnarechinus=fixed(0)
;


prset nodeagepr=calibrated; 
prset clockvarpr=igr; 
prset igrvarpr=exp(10); 
prset clockratepr=normal(0.001,0.01); 


prset brlenspr=clock:fossilization;
prset sampleprob=0.0004; 
prset samplestrat=fossilTip;


prset speciationpr=exponential(10);
prset extinctionpr=beta(1,1);
prset fossilizationpr=beta(1,1);

prset treeagepr=offsetexp(174.7,254.2);


mcmcp nrun=2 nchain=4 temp=0.10 ngen=9000000 samplefreq=500 printfreq=500 diagnfr=5000 savebrlens=yes relburnin=yes burninfrac=0.25;
mcmc;

sumt contype=allcompat;
sump;

end;
