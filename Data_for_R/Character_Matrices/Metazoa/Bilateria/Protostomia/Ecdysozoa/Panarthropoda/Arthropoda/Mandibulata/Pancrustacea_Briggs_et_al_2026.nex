BEGIN MRBAYES;
OUTGROUP Priapulus_caudatus;
set autoclose = yes nowarn = yes;
CTYPE UNORDERED : 1 -297;
LSET coding = variable rates = gamma;
mcmc ngen = 10000000 append = no printfreq = 1000 nruns = 4 samplefreq = 1000 nchains = 4 savebrlens = yes filename = New_Waukartus;
sumt burnin = 25000 contype = allcompat;
sump burnin = 25000;

END;
BEGIN ASSUMPTIONS;
	TYPESET * UNTITLED   =  unord:  1- 297;

END;

BEGIN MESQUITECHARMODELS;
	ProbModelSet * UNTITLED   =  'Mk1 (est.)':  1- 297;
END;

