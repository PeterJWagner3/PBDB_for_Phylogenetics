
#NEXUS

BEGIN DATA;
	DIMENSIONS  NTAX=22 NCHAR=41;
	FORMAT DATATYPE = STANDARD GAP = - MISSING = ? SYMBOLS = "  0 1 2 3";
	MATRIX
	Hebertella_occidentalis  2222(1 2)100201123321012112001102111?12100211
	Mimella_biconvexa     1211002120111112200??010102??????211201??
	Mimella_borealis      011101022000?000101??01?0?2??????1??2?2??
	Mimella_costellata    0000002200131111121??010202??????011211??
	Mimella_extensa       21102011101111111111001010201110010020201
	Mimella_gilbertis     0001000100002332201??010002??????021202??
	Mimella_globosa       222221202011233221021120211020?1211120201
	Mimella_globularis    00002010101322210000011010111001?11000100
	Mimella_imperator     110??11210001221120??01100210101010021200
	Mimella_intermedia    1110001011111332110??11120201??00210202?1
	Mimella_laticardina   1111002000111221100010??20201001211010100
	Mimella_minganensis   0000201010002001211??0112020??????10002??
	Mimella_nuclea        1000011210000000120??011212???????30101??
	Mimella_nucleoidea    000000211000200001120110102010??1100201?1
	Mimella_similis       0110001010132000110000102020?00121101010?
	Mimella_subquadrata   1001002011131000111??1101000???2?210201??
	Mimella_sulcata       1111001010112032120??010201??????210201??
	Mimella_tumida        1111011000131111110??010202??????210201??
	Mimella_ulrichi       0000002211111111120??010202??????210002??
	Mimella_virginiensis  1111001200131221120??010101??????110211??
	Mimella_vulgaris      0100001020111111121??011001?0??1?21010?00
	Mimella_wardenella    011?101000131332100000112?20100221102?210

;
END;
begin mrbayes;
	charset all = 1 - 41;
	[exclude 4 8 11 12 14 15 17 18 19 20 21 28 33 34;]

[TOPOLOGY CONSTRAINT ON INGROUP]

constraint ingroup = biconvexa borealis costellata extensa gilbertis globosa globularis imperator intermedia laticardina minganensis nuclea nucleoidea similis subquadrata sulcata tumida ulrichi virginiensis vulgaris wardenella;
prset topologypr = constraints(ingroup);


[CHARACTER EVOLUTION AND RATE HETEROGENEITY AMONG CHARACTERS]

[morphology model settings]
	[set coding and rates]
		lset nbetacat=5 rates=lnorm Coding=informative; [lognormal rate variation among characters]
		prset symdirihyperpr=fixed(infinity);
		[prset symdirihyperpr=uniform(1,10);]

[TIP AGE CALIBRATIONS]

calibrate Hebertella_occidentalis = fixed (445.2);
calibrate Mimella_biconvexa = uniform(448.9, 458.4);
calibrate Mimella_borealis = uniform(450.3, 462.5);
calibrate Mimella_costellata = uniform( 456.6, 458.4);
calibrate Mimella_extensa = uniform(453, 456.6);
calibrate Mimella_gilbertis = uniform(456.6, 462.5);
calibrate Mimella_globosa = uniform (450.3, 456.6);
calibrate Mimella_globularis = uniform(450.3, 456.6);
calibrate Mimella_imperator = uniform(456.6, 462.5);
calibrate Mimella_intermedia = uniform(456.6, 462.5);
calibrate Mimella_laticardina = uniform(456.6, 458.4);
calibrate Mimella_minganensis = uniform(456.6, 462.5);
calibrate Mimella_nuclea = uniform (456.6, 462.5);
calibrate Mimella_nucleoidea = uniform(456.6, 462.5);
calibrate Mimella_similis = uniform(456.6, 458.4);
calibrate Mimella_subquadrata = uniform(453, 456.6);
calibrate Mimella_sulcata = uniform(453, 456.6);
calibrate Mimella_tumida = uniform(456.6, 458.4);
calibrate Mimella_ulrichi = uniform(456.6, 462.5);
calibrate Mimella_virginiensis = uniform(458.4, 462.5);
calibrate Mimella_vulgaris = uniform (456.6, 462.5);
calibrate Mimella_wardenella = uniform(453, 456.6);
[These taxa had fixed tip ages: occidentalis ]


[SKYLINE FOSSILIZED BIRTH DEATH MODEL & TREE PRIOR]
	[prset treeagepr = uniform(467.3, 470.0);	[Dapingian divergence/origination of Mimella]
	prset treeagepr = uniform(467.3, 477.0);	[late Early to Middle Ordovician divergence]
    prset brlenspr=clock:fossilization;			[FBD prior with sampled ancestors]
   	prset speciationpr = uniform(0.01,10); 		[uninformative, vague prior spanning orders of magnitude]
	prset extinctionpr = beta(1,1);				[flat (i.e, uniform) prior]
	prset fossilizationpr = beta(2,2);		    ['hump-shaped' distribution centered on 0.5, vague but optimistic preservation rate prior, these are brachiopods after all]

	[4 time bins =  Dapingian, Darriwilian, Sandbian, Katian]
	prset samplestrat = random 3: 467.3 0, 458.4 0, 453.0 0;
	prset sampleprob = 1;

[RELAXED CLOCK MODEL PRIORS]
	prset clockratepr = normal(0.001,0.1);
   	prset clockvarpr=igr; [uncorrelated branch rates]
    prset igrvarpr = uniform(0.001, 10); [broad prior spanning several orders of magnitude]
	prset nodeagepr = calibrated;


[MCMC SETTINGS]
	mcmcp ngen=10000000 relburnin=yes burninfrac=0.25 printfreq=1000 samplefreq=10000 nchains=2 nruns=2 temp=0.05 savebrlens=yes;

[RUN ANALYSIS]
	mcmc;
	sumt burnin=250;
	sump burnin=250;


END;
